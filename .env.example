# Runtime reads the pooled connection string. Schema and bulk reload use the direct string.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@POOLER_HOST/DB?sslmode=require
DATABASE_URL_DIRECT=postgresql+psycopg://USER:PASSWORD@DIRECT_HOST/DB?sslmode=require
TEST_DATABASE_URL=postgresql+psycopg://USER:PASSWORD@TEST_HOST/TEST_DB?sslmode=require
DATA_DIR=datasets
TZ=Asia/Kolkata
SECTOR=college
TARIFF_INR_PER_KWH=8
GRID_EF=0.716
WATER_TARIFF_INR_PER_KL=40
GROQ_API_KEY=
GROQ_MODEL=
JEV_API_KEY=
# The official TypeSafe URL and pinned jev-1.13.0 model are defaults in app/decision/jev.py.
DECISION_PROVIDER=jev
DECISION_ON_ERROR=needs_review
FRONTEND_ORIGIN=http://localhost:5173
VITE_API_BASE_URL=http://localhost:8000
VITE_USE_MOCK=false

# Automatically align the dataset calendar with the current IST date.
REPLAY_ALIGN_TODAY=true
WEATHER_FORECAST_ENABLED=true
WEATHER_LATITUDE=28.65195
WEATHER_LONGITUDE=77.23149

# Render single-service deployment: set these in Render Environment.
# Copy existing database/API credentials above; choose your administrator login.
ADMIN_EMAIL=
ADMIN_PASSWORD=
CARE_SESSION_SECRET=
# FRONTEND_ORIGIN and CARE_PUBLIC_URL use Render's URL automatically when unset.
# See deployment/README.md. Keep npm run dev for local development only.
